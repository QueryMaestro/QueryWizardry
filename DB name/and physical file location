/* TempDB files + drives */
SELECT
   'tempdb' AS database_name,
   name,
   physical_name,
   LEFT(physical_name, 2) AS drive
FROM sys.master_files
WHERE database_id = 2;
/* All databases – data vs log drives */
SELECT
   DB_NAME(database_id) AS database_name,
   type_desc,
   name,
   physical_name,
   LEFT(physical_name, 2) AS drive
FROM sys.master_files
ORDER BY database_name, type_desc;
