4.

Bring all the databases Online:

-- Recover ALL secondary DBs currently in RESTORING/STANDBY
DECLARE @sql nvarchar(max) =
(SELECT STRING_AGG('RESTORE DATABASE ['+name+'] WITH RECOVERY;', CHAR(10))
FROM sys.databases
WHERE state_desc IN ('RESTORING','STANDBY'));
PRINT @sql;  -- review the statements
EXEC (@sql);
-- Verify
SELECT name, state_desc
FROM sys.databases
WHERE name NOT IN ('master','model','msdb','tempdb', 'DBA')
ORDER BY name;
