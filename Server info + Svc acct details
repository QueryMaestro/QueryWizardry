SELECT  
   @@SERVERNAME AS server_name,
   servicename,
   service_account
FROM sys.dm_server_services
WHERE service_account LIKE 'NT SERVICE\%'      -- virtual accounts
  OR service_account LIKE 'LocalSystem%'
  OR service_account LIKE 'NT AUTHORITY\%';
