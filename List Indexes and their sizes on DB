USE DB_Name;
GO
SELECT
   OBJECT_NAME(i.object_id) AS TableName,
   i.name AS IndexName,
   i.type_desc AS IndexType,
   SUM(ps.used_page_count) * 8.0 / 1024 AS IndexSizeMB
FROM
   sys.indexes AS i
INNER JOIN
   sys.dm_db_partition_stats AS ps
   ON i.object_id = ps.object_id AND i.index_id = ps.index_id
WHERE
   i.object_id = OBJECT_ID('[Schema].['Table_Name'])
GROUP BY
   i.object_id, i.index_id, i.name, i.type_desc
ORDER BY
   IndexSizeMB DESC;
